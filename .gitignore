# Build outputs
/dist
/node_modules
/src-tauri/target
/src-tauri/Cargo.lock
src-tauri/binaries/*.exe
src-tauri/binaries/*.dll

# Tauri updater signing key. The .pub file IS committed (so the
# app can verify signed updates) but the private .key must NEVER
# be committed — losing it means no future updates can be signed.
src-tauri/.tauri-updater.key
# Build outputs for the auxiliary tauri-signer crate (a local
# replacement for the broken tauri-cli signer — see
# src-tauri/crates/tauri-signer/). The target/ subdir is local
# build output and shouldn't go in git.
src-tauri/crates/tauri-signer/target/
src-tauri/crates/tauri-signer/Cargo.lock
# Runtime cache (wry / webview2 data, written to cwd in dev mode)
src-tauri/cache.db
src-tauri/cache.db-shm
src-tauri/cache.db-wal
src-tauri/EBWebView/
# OS junk
.DS_Store
Thumbs.db
# Editor
.vscode
.idea
*.swp
# Logs
*.log
npm-debug.log*
yarn-debug.log*
# Local config
.env.local
.env.*.local
src-tauri/.env
# Generated latest.json (Tauri updater manifest) lives next to the project root
latest.json
# Linux build outputs (the .deb we ship lives in dist-release/ but the
# raw tauri bundle output shouldn't pollute the repo)
/src-tauri/target/release/bundle/deb/*.deb
# Temporary / test scratch space
*.TRASH
*.bak
*portable.exe
*portable.exe.sig
*.tsbuildinfo
test-*.json
test-*.mjs
test-*.js
*.bat
TAG_MESSAGE.txt
# Linux build helper artifacts (WSL2)
.wsl/
src-tauri/binaries/sing-box-*
src-tauri/binaries/xray-*
# Tauri generated mobile/desktop projects: gen/ is mostly build junk,
# BUT gen/android contains our hand-written Kotlin VPN layer, manifest
# and gradle customizations — those MUST be tracked (Tauri docs also
# recommend committing the generated Android project once customized).
# So instead of ignoring all of gen/, ignore only derived artifacts:
/src-tauri/gen/schemas
/src-tauri/gen/android/.gradle
/src-tauri/gen/android/.idea
/src-tauri/gen/android/.cxx
/src-tauri/gen/android/build
/src-tauri/gen/android/local.properties
/src-tauri/gen/android/**/build
/src-tauri/gen/android/**/*.iml
/src-tauri/gen/android/jni
# libbox.aar is a 28MB prebuilt binary — CI rebuilds it from the
# Leadaxe/sing-box-lx fork (see .github/workflows/release-android.yml),
# so the AAR itself is not committed.
/src-tauri/gen/android/app/libs/*.aar
# Never commit Android signing material.
/src-tauri/gen/android/key.properties
/src-tauri/gen/android/**/*.keystore
/src-tauri/gen/android/**/*.jks
# Windows sing-box sidecar (and its runtime DLLs). macOS / Linux
# sidecars (no extension / .app bundles / AppImage) are NOT ignored
# — they're committed so end-users don't need to install sing-box
# themselves. Same for icon.icns (macOS bundle icon).
# Tauri updater signing key. The .pub file IS committed (so
# clients can verify our signatures); the secret key is NEVER
# committed.
# Local env / secrets
.env
# Tauri / Cargo build cache artifacts
Cargo.lock.bak
**/*.rs.bk
# Tauri / Vite dev output
**/node_modules
# OS / editor scratch
# mavis / agent throwaway files. `.tmp*/` covers .tmp-gh, .tmp.TRASH,
# .tmp-rebuild, etc.; `*.TRASH` covers per-extension backups; the
# rest are specific file names we've seen pollute the working tree.
dist-release/
# Local Android build scratch: NDK zip (~750MB), gomobile output AAR,
# extracted jars, logs. CI rebuilds all of this from scratch.
/.android-build/
# Xray sidecar binary for Android. We never commit it. CI/dev run
# scripts/build-android-xray.ps1 + scripts/verify-android-xray-binary.ps1
# to download, verify, and stage the binary locally before each build.
# The verifier pins SHA-256 to upstream XTLS/Xray-core v26.7.28.
# Note: AGP's jniLibs packaging filters non-.so files, so the staged
# file is named `libxray.so` even though we exec it as a standalone
# binary at runtime.
/src-tauri/gen/android/app/src/main/jniLibs/arm64-v8a/xray
/src-tauri/gen/android/app/src/main/jniLibs/arm64-v8a/libxray.so
# Tauri Rust core (libcloakwire_lib.so) for Android. We never commit
# it. The file is recovered from a known-good v1.2.0 reference APK
# via scripts/extract-tauri-core.ps1 because the local Tauri Rust
# build is blocked by the WebSocket client failure. The extracted
# file is ABI-compatible with the unchanged Java side; re-validate
# after any Cargo / Tauri / Tauri-plugin change.
/src-tauri/gen/android/app/src/main/jniLibs/arm64-v8a/libcloakwire_lib.so
# A file literally named "NUL" — Windows reserved-name artifact from a
# mis-redirected shell command; must never be committed (git on
# Windows can't even check it out cleanly).
NUL
# Generated latest.json (Tauri updater manifest) lives next to the
# project root on a release engineer machine. NEVER committed; we
# always upload it as a Release asset instead so the running app
# can fetch the same canonical URL across all installs.
/latest.json
# --- Xray-only rebuild (2026-08-21) ---
# NDK build output of the vendored hev-socks5-tunnel module (obj/, libs/).
/src-tauri/gen/android/jni/hev-socks5-tunnel/obj/
/src-tauri/gen/android/jni/hev-socks5-tunnel/libs/
# Xray geodata: downloaded at build-prep time (same policy as libxray.so),
# staged into jniLibs so xray can read it from nativeLibraryDir.
/src-tauri/gen/android/app/src/main/jniLibs/arm64-v8a/*.dat
/src-tauri/gen/android/app/src/main/assets/geo*.dat
