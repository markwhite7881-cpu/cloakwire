<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_toggle_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_card"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="10dp">

    <!-- Power Toggle Button -->
    <ImageView
        android:id="@+id/widget_btn_power"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/widget_power_btn_bg"
        android:contentDescription="@string/app_name"
        android:padding="10dp"
        android:src="@drawable/ic_widget_power" />

    <!-- Info Column -->
    <LinearLayout
        android:id="@+id/widget_info_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_text_server"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:text="@string/app_name"
            android:textColor="@color/widget_text_primary"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/widget_dot_status"
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:contentDescription="@null"
                android:src="@drawable/widget_dot_status" />

            <TextView
                android:id="@+id/widget_text_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/widget_state_disconnected"
                android:textColor="@color/widget_text_muted"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
