{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cloakwire",
  "version": "1.4.1",
  "identifier": "app.cloakwire.client",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Cloakwire",
        "width": 1060,
        "height": 720,
        "minWidth": 1040,
        "minHeight": 680,
        "maxWidth": 1120,
        "maxHeight": 800,
        "resizable": true,
        "maximizable": false,
        "fullscreen": false,
        "center": true,
        "decorations": true,
        "transparent": false,
        "backgroundColor": "#090a0f"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: tauri: https://asset.localhost http://asset.localhost; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; frame-src 'none'; object-src 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "externalBin": [
      "binaries/sing-box",
      "binaries/xray"
    ],
    "category": "Utility",
    "shortDescription": "Cloakwire VPN client",
    "longDescription": "Cross-platform GUI VPN client built on top of sing-box core. Cloakwire is a privacy-first client that wraps sing-box's protocol stack in a clean, minimal UI."
  }
}
