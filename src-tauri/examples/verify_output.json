  "route": {
    "auto_detect_interface": true,
    "default_domain_resolver": "local",
    "final": "proxy",
    "find_process": true,
    "rules": [
      {
        "action": "hijack-dns",
        "port": [
          53
        ]
      },
      {
        "action": "route",
        "ip_is_private": true,
        "outbound": "direct"
