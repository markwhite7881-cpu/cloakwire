      "listen": "127.0.0.1",
      "listen_port": 2080,
      "tag": "mixed-in",
      "type": "mixed"
    }
  ],
  "log": {
    "level": "info",
    "timestamp": true
  },
  "outbounds": [
    {
      "interrupt_exist_connections": false,
      "interval": "30s",
      "outbounds": [
        "🇩🇪 DE-1",
        "🇳🇱 NL-Edge",
        "🇸🇬 SG-1",
        "🇺🇸 US-Trojan"
      ],
      "tag": "auto",
      "tolerance": 50,
      "type": "urltest",
      "url": "https://www.gstatic.com/generate_204"
