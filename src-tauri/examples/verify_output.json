    {
      "default": "auto",
      "outbounds": [
        "auto",
        "🇩🇪 DE-1",
        "🇳🇱 NL-Edge",
        "🇸🇬 SG-1",
        "🇺🇸 US-Trojan"
      ],
      "tag": "proxy",
      "type": "selector"
    },
    {
      "tag": "direct",
      "type": "direct"
    },
    {
      "tag": "block",
      "type": "block"
    },
    {
      "flow": "xtls-rprx-vision",
      "server": "de.example.com",
      "server_port": 443,
      "tag": "🇩🇪 DE-1",
      "tls": {
        "enabled": true,
        "reality": {
          "enabled": true,
          "public_key": "PLACEHOLDER_REALITY_PUBKEY",
          "short_id": "abcd1234"
        },
        "server_name": "cdn.example.com",
        "utls": {
          "enabled": true,
          "fingerprint": "chrome"
        }
      },
      "type": "vless",
      "uuid": "b2a3d6c8-1111-2222-3333-444455556666"
    },
    {
      "obfs": {
        "password": "op-secret",
        "type": "salamander"
      },
      "password": "mysecret",
      "server": "hy.example.com",
      "server_port": 443,
      "tag": "🇳🇱 NL-Edge",
      "tls": {
        "enabled": true,
        "server_name": "hy.example.com"
      },
      "type": "hysteria2"
    },
    {
      "method": "chacha20-ietf-poly1305",
      "password": "secret",
      "server": "1.2.3.4",
      "server_port": 8388,
      "tag": "🇸🇬 SG-1",
      "type": "shadowsocks"
    },
    {
      "password": "supersecret",
      "server": "tr.example.com",
      "server_port": 443,
      "tag": "🇺🇸 US-Trojan",
      "tls": {
        "enabled": true,
        "server_name": "tr.example.com"
