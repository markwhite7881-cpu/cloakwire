{
  "dns": {
    "final": "remote",
    "servers": [
      {
        "server": "1.1.1.1",
        "tag": "local",
        "type": "udp"
      },
      {
        "detour": "proxy",
        "domain_resolver": "local",
        "path": "/dns-query",
        "server": "dns.google",
        "tag": "remote",
        "type": "https"
      }
    ],
    "strategy": "prefer_ipv4"
  },
  "experimental": {
    "clash_api": {
      "default_mode": "proxy",
      "external_controller": "127.0.0.1:9090"
